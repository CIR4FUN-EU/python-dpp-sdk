# Copy this file to .env before starting Docker. It is intentionally non-secret and ignored by Git.
# Use a unique project name and unused paired ports when another Compose project is already running.
COMPOSE_PROJECT_NAME=dpp-java-services-demo-local
DPP_REPO_IMAGE=ghcr.io/cir4fun-eu/dpp-repo-api:0.5.1
DPP_REGISTRY_IMAGE=ghcr.io/cir4fun-eu/dpp-registry-api:0.5.1
DPP_REPO_BASE_URL=http://localhost:18080
DPP_REGISTRY_BASE_URL=http://localhost:18081
MOCK_REPO_PORT=18080
MOCK_REGISTRY_PORT=18081
DPP_REPO_PORT=18080
DPP_REGISTRY_PORT=18081
DPP_REPO_BACKEND=postgres
DPP_REGISTRY_BACKEND=postgres
MOCK_REPO_POSTGRES_PORT=15433
MOCK_REPO_POSTGRES_DB=dpp_repo
MOCK_REPO_POSTGRES_USER=dpp_repo
MOCK_REPO_POSTGRES_PASSWORD=dpp_repo
MOCK_REGISTRY_POSTGRES_PORT=15434
MOCK_REGISTRY_POSTGRES_DB=dpp_registry
MOCK_REGISTRY_POSTGRES_USER=dpp_registry
MOCK_REGISTRY_POSTGRES_PASSWORD=dpp_registry
DPP_STARTUP_TIMEOUT_SECONDS=120
